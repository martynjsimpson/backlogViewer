  "description": "Local dashboard and conformance checker for the manifest-driven work-management model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martynjsimpson/backlogViewer.git"
  },
  "homepage": "https://github.com/martynjsimpson/backlogViewer#readme",
  "bugs": {
